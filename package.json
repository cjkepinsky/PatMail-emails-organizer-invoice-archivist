{
  "name": "invoice-archivist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "tsx watch src/server/index.ts",
    "web": "vite --host 127.0.0.1",
    "dev": "concurrently \"npm run api\" \"npm run web\"",
    "dev:start": "node scripts/start-dev.mjs",
    "dev:stop": "node scripts/stop-dev.mjs",
    "dev:status": "node scripts/status-dev.mjs",
    "dev:restart": "npm run dev:stop && npm run dev:start",
    "auth:reset": "node scripts/reset-auth.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "googleapis": "^166.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}
