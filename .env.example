PORT=8797
APP_ORIGIN=http://127.0.0.1:5181

# Create an OAuth client in Google Cloud Console.
# Use redirect URI: http://127.0.0.1:8797/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8797/api/auth/google/callback

DATA_DIR=.local
DEFAULT_ARCHIVE_DIR=

# Mailbox chat uses OpenAI API. The token can also be entered in the app settings.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Legacy/profile setting kept for compatibility with older local-LLM configuration.
LLM_BASE_URL=http://192.168.1.90:1234

# Lightweight local classifier. The endpoint must be OpenAI-compatible.
CLASSIFIER_MODE=hybrid
CLASSIFIER_BASE_URL=http://127.0.0.1:11434
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=tinydolphin:latest
CLASSIFIER_TIMEOUT_MS=2500
